# Public build-time config (no secrets here; secrets go in .env.local, which is git-ignored).
# CI overrides VITE_BASE and VITE_SITE_URL from the GitHub context in .github/workflows/pages.yml.
VITE_GITHUB_ORG=goatsoft
VITE_SITE_URL=https://goatsoft.github.io/
VITE_BASE=/

# Web3Forms access key for the contact form (public by design: submit-only, not a secret).
VITE_WEB3FORMS_KEY=b3543270-8626-4049-a76f-8828499b0ea3
