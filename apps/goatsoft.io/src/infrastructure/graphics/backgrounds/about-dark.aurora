        "intensity": 0.22,
        "scale": 0.9,
        "speed": 0.05,
        "seed": 11,
        "stretch": 0.5
      }
    },
    {
      "type": "curtain",
      "colors": [
        2,
        0,
        1
      ],
      "blend": "screen",
      "opacity": 0.35,
      "params": {
        "intensity": 0.7,
        "base": 0.7,
        "height": 0.5,
        "wave": 0.45,
