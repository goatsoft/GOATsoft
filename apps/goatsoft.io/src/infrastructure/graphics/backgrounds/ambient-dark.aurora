{
  "$schema": "https://aurora.goatsoft.io/schema/v1.json",
  "format": "aurora",
  "version": 1,
  "name": "GOATsoft ambient (dark)",
  "canvas": {
    "fixed": true,
    "parallax": 0.22
  },
  "palette": [
    "color(srgb 0.86 0.88 0.93)",
    "color(srgb 0.72 0.75 0.82)",
    "color(srgb 0.96 0.97 1)",
    "color(srgb 0.04 0.045 0.06)"
  ],
  "layers": [
    {
      "type": "starfield",
      "colors": [
        3,
        3,
        2
      ],
      "params": {
        "sky": 0,
        "density": 0.35,
        "brightness": 0.55,
        "twinkle": 0.45,
        "milkyway": 0.2,
        "meteors": 0.06,
        "speed": 0.15
      }
    },
    {
      "type": "aurora-fbm",
      "colors": [
        0,
        1,
        2
      ],
      "mix": "srgb",
      "params": {
        "intensity": 0.16,
        "scale": 1,
        "speed": 0.04,
        "seed": 0,
        "stretch": 0.55
      },
      "blend": "screen"
    }
  ]
}
