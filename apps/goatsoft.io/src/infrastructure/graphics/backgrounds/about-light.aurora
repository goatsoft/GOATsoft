{
  "$schema": "https://aurora.goatsoft.io/schema/v1.json",
  "format": "aurora",
  "version": 1,
  "name": "GOATsoft about (light)",
  "canvas": {
    "fade": "y"
  },
  "palette": [
    "color(srgb 0.17 0.18 0.23)",
    "color(srgb 0.3 0.32 0.38)",
    "color(srgb 0.1 0.11 0.15)"
  ],
  "layers": [
    {
      "type": "aurora-fbm",
      "colors": [
        0,
        1,
        2
      ],
      "mix": "srgb",
      "params": {
        "intensity": 0.12,
        "scale": 0.9,
        "speed": 0.05,
        "seed": 11,
        "stretch": 0.5
      }
    },
    {
      "type": "curtain",
      "colors": [
        2,
        0,
        1
      ],
      "opacity": 0.16,
      "params": {
        "intensity": 0.7,
        "base": 0.7,
        "height": 0.5,
        "wave": 0.45,
        "rays": 0.55,
        "rise": 0.15,
        "speed": 0.06
      }
    }
  ]
}
